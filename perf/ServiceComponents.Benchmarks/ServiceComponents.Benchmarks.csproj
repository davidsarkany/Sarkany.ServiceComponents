<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Micro benchmarks of the hot paths. Run through perf/run.sh, which executes every benchmark twice in one
    BenchmarkDotNet session: once built with -p:ScTarget=Baseline (pre-rewrite packages, the baseline column)
    and once with -p:ScTarget=Current (this repository).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ScPackage Include="ServiceComponents.AspNet" />
  </ItemGroup>

</Project>
