<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Throughput and latency on real transports: the Orders sample over HTTP (Kestrel) and a RabbitMQ round trip
    (Testcontainers). Built twice by perf/run.sh: -p:ScTarget=Baseline and -p:ScTarget=Current.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ScPackage Include="ServiceComponents.AspNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Orders.Service\Orders.Service.csproj" />
  </ItemGroup>

</Project>
