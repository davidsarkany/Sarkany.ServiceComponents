<Project>

  <Import Project="..\versions.props" />

  <!--
    The samples consume ServiceComponents exactly like an application would.
    ScTarget selects which ServiceComponents they are built against:
      Current  (default) - project references to ../src (the code in this repository)
      Baseline           - the original ServiceComponents.* packages $(ScBaselineVersion) from nuget.org
                           (default: $(UpstreamVersion) from versions.props)
      Package            - this repository packed as $(ScPackageIdPrefix)ServiceComponents.* $(ScPackageVersion)
                           from the local feed artifacts/packages (drop-in check, see build/dropin.sh)
    Projects list the packages they need as <ScPackage Include="ServiceComponents.X" /> items.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ScTarget Condition="'$(ScTarget)' == ''">Current</ScTarget>
    <!-- Lets samples skip code that shows fixes of this repository when built against the original packages. -->
    <DefineConstants Condition="'$(ScTarget)' == 'Baseline'">$(DefineConstants);SC_BASELINE</DefineConstants>
    <ScBaselineVersion Condition="'$(ScBaselineVersion)' == ''">$(UpstreamVersion)</ScBaselineVersion>
    <ScPackageIdPrefix Condition="'$(ScPackageIdPrefix)' == ''">Sarkany.</ScPackageIdPrefix>
    <ScPackageVersion Condition="'$(ScPackageVersion)' == ''">0.0.0-local</ScPackageVersion>
    <ScSourceRoot>$(MSBuildThisFileDirectory)..\src\</ScSourceRoot>
    <RestoreAdditionalProjectSources Condition="'$(ScTarget)' == 'Package'">$(MSBuildThisFileDirectory)..\artifacts\packages</RestoreAdditionalProjectSources>
    <!-- Keep the outputs of the builds apart so they can exist side by side. -->
    <BaseIntermediateOutputPath Condition="'$(ScTarget)' == 'Baseline'">obj\baseline\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(ScTarget)' == 'Baseline'">bin\baseline\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(ScTarget)' == 'Package'">obj\package\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(ScTarget)' == 'Package'">bin\package\</BaseOutputPath>
    <!-- Sources of one build must never pick up generated files of the other. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
