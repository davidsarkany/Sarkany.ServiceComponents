{
  "Notifications": {
    "OrdersUri": "http://localhost:5100/api/generic",
    "Rabbit": {
      "Enabled": true,
      "ConnectionString": "amqp://guest:guest@localhost:5672",
      "ClientName": "notifications",
      "Queue": "notifications",
      "Exchange": "orders-events",
      "RetryIntervals": [ 1000, 5000 ]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
