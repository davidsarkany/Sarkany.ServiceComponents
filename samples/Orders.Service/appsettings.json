{
  "Orders": {
    "Rabbit": {
      "Enabled": false,
      "ConnectionString": "amqp://guest:guest@localhost:5672",
      "ClientName": "orders",
      "Queue": "orders",
      "Exchange": "orders-events",
      "RetryIntervals": [ 1000, 5000 ]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
