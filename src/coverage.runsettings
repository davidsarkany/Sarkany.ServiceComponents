<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of the published ServiceComponents.* packages only. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[ServiceComponents.*]*</Include>
          <Exclude>[ServiceComponents.*Tests]*,[ServiceComponents.UnitTests.Fixtures]*,[ServiceComponents.Test]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
